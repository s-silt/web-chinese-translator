{
  "name": "web-chinese-translator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "GitHub 汉化与网页翻译扩展（Chrome、Edge 提供固定词库与模型翻译；Firefox 仅 GitHub 汉化）",
  "license": "MIT",
  "homepage": "https://github.com/s-silt/web-chinese-translator#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-silt/web-chinese-translator.git"
  },
  "bugs": {
    "url": "https://github.com/s-silt/web-chinese-translator/issues"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:all": "bun run build && bun run build:edge && bun run build:firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "bun run zip && bun run zip:edge && bun run zip:firefox",
    "pack:crx": "tsx scripts/pack-crx.ts",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:live": "bun run build && node --env-file=tests/e2e/live.env node_modules/@playwright/test/cli.js test --project=live",
    "icons": "tsx scripts/render-icons.ts",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "check:locale": "tsx scripts/check-locale.ts",
    "check:parity": "tsx scripts/check-parity.ts",
    "harvest": "tsx scripts/harvest.ts",
    "postinstall": "wxt prepare",
    "coverage:locale": "tsx scripts/coverage.ts"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lexical/rich-text": "0.53.0",
    "@playwright/test": "^1.64.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@types/lodash": "4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "lexical": "0.53.0",
    "magic-string": "^1.4.3",
    "prettier": "^3.9.10",
    "quill": "2.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roosterjs": "9.61.0",
    "sharp": "^0.35.5",
    "slate": "0.147.4",
    "slate-dom": "0.147.3",
    "slate-react": "0.147.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
